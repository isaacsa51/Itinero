}

### 3. Create an activity expense with custom split
POST {{base_url}}/trips/{{group_code}}/expenses
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Museum Tickets",
  "amount": 80.00,
  "category": "Entertainment",
  "paymentMethod": "Debit Card",
  "splitType": "Custom",
  "notes": "Art museum entrance tickets - some members got discounts",
  "debtors": [
    {
      "userId": 1,
      "amount": 25.00
    },
    {
      "userId": 2,
      "amount": 20.00
    },
    {
      "userId": 3,
      "amount": 15.00
    },
    {
      "userId": 4,
      "amount": 20.00
    }
  ]
}

### 4. Get current user's expense summary to check balances
GET {{base_url}}/trips/{{group_code}}/expenses/summary
Authorization: Bearer {{auth_token}}

### 5. Get all trip expenses to review
GET {{base_url}}/trips/{{group_code}}/expenses
Authorization: Bearer {{auth_token}}

### 6. Mark an expense as completed when paid
PATCH {{base_url}}/trips/{{group_code}}/expenses/1/complete
Authorization: Bearer {{auth_token}}

### 7. Update an expense if details change
PUT {{base_url}}/trips/{{group_code}}/expenses/1
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Updated Hotel Booking - 4 nights",
  "amount": 600.00,
  "category": "Accommodation",
  "paymentMethod": "Credit Card",
  "splitType": "Equal",
  "notes": "Extended stay by one night",
  "debtors": [
    {
      "userId": 1,
      "amount": 200.00
    },
    {
      "userId": 2,
      "amount": 200.00
    },
    {
      "userId": 3,
      "amount": 200.00
    }
  ]
}

### 8. Delete an expense if created by mistake
# DELETE {{base_url}}/trips/{{group_code}}/expenses/1
# Authorization: Bearer {{auth_token}}